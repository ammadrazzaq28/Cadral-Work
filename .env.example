# ---------------------------------------------------------------------------
# cadral-clickup-slack configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# --- ClickUp -----------------------------------------------------------------

# Personal API token from ClickUp: Settings -> Apps -> API Token.
# Used as the raw Authorization header value (no "Bearer" prefix).
CLICKUP_API_TOKEN=

# The ClickUp list id where "create-task" adds tasks.
# Open the list in the browser; the id is in the URL (…/li/<LIST_ID>),
# or fetch it via the ClickUp API.
CLICKUP_LIST_ID=

# Optional: the secret you set when registering the webhook. When present,
# incoming webhook requests are verified via HMAC-SHA256 of the raw body
# against the X-Signature header. Leave blank to skip verification (a warning
# is logged).
CLICKUP_WEBHOOK_SECRET=

# Optional: comma-separated status NAMES that count as "completed".
# Defaults to: complete,completed,closed,done
# (Statuses whose ClickUp type is "closed" or "done" always count too.)
CLICKUP_COMPLETE_STATUSES=

# --- Slack -------------------------------------------------------------------
# Provide EITHER a bot token (preferred) OR an incoming webhook URL.

# Bot token (xoxb-…) with the chat:write scope. When set, messages are posted
# via chat.postMessage to SLACK_CHANNEL below.
SLACK_BOT_TOKEN=

# Incoming webhook URL (https://hooks.slack.com/services/…). Used only when
# SLACK_BOT_TOKEN is not set. The channel is fixed by the webhook itself.
SLACK_WEBHOOK_URL=

# Channel to post to when using a bot token. Defaults to #all-cadral.
SLACK_CHANNEL=#all-cadral

# --- Server ------------------------------------------------------------------

# Port for the webhook server. Defaults to 3000.
PORT=3000
